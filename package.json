{
  "name": "tool-evolver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @tool-evolver/e2e test",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "check": "pnpm run check:all",
    "check:all": "pnpm run check:adrs && pnpm run check:boundaries && pnpm run check:secrets && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run release:test && pnpm run test:e2e && pnpm run check:smoke && pnpm run release:package && pnpm run release:verify",
    "check:adrs": "node scripts/verify-adrs.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:smoke": "node scripts/verify-binaries.mjs",
    "smoke": "node scripts/verify-binaries.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "release:publish": "node scripts/publish-v1-release.mjs",
    "release:verify": "node scripts/verify-release-cli.mjs",
    "release:test": "vitest run scripts/verify-release.test.mjs scripts/platform-qualification.test.mjs scripts/release-evidence.test.mjs scripts/standalone-release-artifact.test.mjs",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.13.4",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
