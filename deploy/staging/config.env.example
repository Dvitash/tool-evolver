# ==============================================================================
# Tool Evolver Staging Cloud Configuration
# Pinned staging environment variables. No development defaults allowed.
# ==============================================================================

# Node Runtime & Environment
NODE_ENV=production
TOOL_EVOLVER_ENV=staging
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Relational Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=tool_evolver_staging
DATABASE_USER=tool_evolver_staging_user
DATABASE_PASSWORD=replace-with-secure-database-password-staging-2026
DATABASE_URL=postgres://tool_evolver_staging_user:replace-with-secure-database-password-staging-2026@postgres:5432/tool_evolver_staging
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=50
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3 Artifact Repository)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=minio
STORAGE_BUCKET=tool-evolver-staging-artifacts
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minio-staging-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-secure-minio-secret-key-staging-2026
STORAGE_USE_SSL=false
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_EXPIRES_SECONDS=3600

# ------------------------------------------------------------------------------
# Durable Job Queue & Dead-Letter Queue
# ------------------------------------------------------------------------------
QUEUE_PROVIDER=postgres
QUEUE_MAX_CONCURRENCY=16
QUEUE_VISIBILITY_TIMEOUT_MS=60000
QUEUE_MAX_RETRIES=5
QUEUE_BACKOFF_BASE_MS=2000
QUEUE_BACKOFF_MAX_MS=300000
QUEUE_DEAD_LETTER_QUEUE_NAME=tool_evolver_staging_dlq

# ------------------------------------------------------------------------------
# Authentication & Device Authorization (RFC 8628)
# ------------------------------------------------------------------------------
AUTH_TOKEN_SECRET=replace-with-64-character-staging-auth-token-secret-string-2026
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_DEVICE_CODE_TTL_SECONDS=600
AUTH_USER_CODE_LENGTH=8
AUTH_POLL_INTERVAL_SECONDS=5

# ------------------------------------------------------------------------------
# API Server & Network Controls
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
SERVER_MAX_REQUEST_SIZE_BYTES=10485760
SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_ENABLE_METRICS=true
SERVER_METRICS_PORT=9090
SERVER_ENABLE_CORS=true
SERVER_CORS_ALLOWED_ORIGINS=https://staging.toolevolver.internal

# ------------------------------------------------------------------------------
# Artifact Signing & Trust Configuration
# ------------------------------------------------------------------------------
SIGNING_KEY_ID=staging-ed25519-primary-2026
SIGNING_KEY_ALGORITHM=ed25519
SIGNING_KEY_PASSPHRASE=replace-with-secure-signing-key-passphrase-staging-2026

# ------------------------------------------------------------------------------
# Automated Backup & Recovery
# ------------------------------------------------------------------------------
BACKUP_SCHEDULE=0 */6 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=tool-evolver-staging-backups
BACKUP_ENCRYPTION_KEY=replace-with-secure-aes256-backup-encryption-key-staging-2026
