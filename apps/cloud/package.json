{
  "name": "@tool-evolver/cloud",
  "version": "0.1.0",
  "description": "Cloud management and orchestration service.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node dist/bin/migrate.js",
    "worker": "node dist/bin/worker.js",
    "api": "node dist/bin/api.js",
    "scheduler": "node dist/bin/scheduler.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@tool-evolver/contracts": "workspace:*",
    "@tool-evolver/crypto": "workspace:*",
    "@tool-evolver/db": "workspace:*",
    "@tool-evolver/protocol": "workspace:*",
    "@tool-evolver/runtime": "workspace:*",
    "typescript": "^5.7.3",
    "zod": "^3.25.76"
  }
}
